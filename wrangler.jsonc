{
  "name": "timetableplanner",
  "main": "mcp-worker.mjs",
  "compatibility_date": "2026-11-06",
  "build": { "command": "node tools/update-modified.mjs" },
  "vars": {
    "CHAT_TOKEN_ALLOWANCE": "125000",
    "CHAT_TOTAL_TOKEN_CAP": "6000000",
    "CHAT_EXPERIMENT_END": "2026-12-12T00:00:00+11:00"
  },
  "durable_objects": { "bindings": [{ "name": "CHAT_USAGE", "class_name": "ChatUsage" }] },
  "migrations": [{ "tag": "chat-usage-v1", "new_sqlite_classes": ["ChatUsage"] }],
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1004", "simple": { "limit": 6, "period": 60 } },
    { "name": "CHAT_WORK_LIMITER", "namespace_id": "1005", "simple": { "limit": 18, "period": 60 } },
    { "name": "CHAT_TOTAL_WORK_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/chat"]
  }
}
